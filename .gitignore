# Repository-wide ignores. Each project also has its own .gitignore; this is the
# backstop so a secret can never be committed from either side.

# Secrets — never commit. .env.example is the tracked template.
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
build/
*.tsbuildinfo

# Tooling scratch
.playwright-cli/
.playwright-mcp/
output/
coverage/
.vite/
*.log
npm-debug.log*

# End-to-end run artefacts (reports, traces, videos, screenshots)
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
playwright/.cache/

# The private assessment brief is not ours to publish.
Taher_Employee_Management_AI_Product_Engineering_Challenge.pdf

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.gstack/
