# Base URL for the Employee Management Platform API.
# Left empty in development so requests go to /api/v1 on the Vite dev server,
# which proxies them to the backend (see vite.config.js) - same-origin, no CORS.
# For a split deployment set this to the absolute API URL, e.g.
#   VITE_API_URL=https://ems-api.example.com/api/v1
VITE_API_URL=

# Where the dev proxy forwards /api requests.
VITE_PROXY_TARGET=http://localhost:4000
